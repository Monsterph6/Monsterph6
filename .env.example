# PostgreSQL
POSTGRES_USER=cdc_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cdc_equipment
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Built from the POSTGRES_* values above; used directly by the backend
DATABASE_URL=postgresql+psycopg2://cdc_admin:change_me@db:5432/cdc_equipment

# Auth
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (dev only; production serves frontend + backend behind the same nginx origin)
FRONTEND_ORIGIN=http://localhost:5173

# Initial admin account created by the seed script
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_admin
SEED_ADMIN_EMAIL=admin@cdchaiphong.gov.vn
